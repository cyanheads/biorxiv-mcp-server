{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "biorxiv-mcp-server",
  "version": "0.2.8",
  "description": "Search and retrieve bioRxiv and medRxiv preprints — by DOI, date interval, or keyword — via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/biorxiv-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/biorxiv-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": ["biorxiv", "medrxiv", "preprint", "biomedical", "mcp", "mcp-server", "model-context-protocol"],
  "userConfig": {
    "BIORXIV_MAILTO": {
      "type": "string",
      "title": "Contact email",
      "description": "Optional. Sent in the User-Agent header for polite API access per Cold Spring Harbor Lab guidelines.",
      "default": ""
    }
  },
  "mcpServers": {
    "biorxiv-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/biorxiv-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "BIORXIV_MAILTO": "${user_config.BIORXIV_MAILTO}"
      }
    }
  }
}
